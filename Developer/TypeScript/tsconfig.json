{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "../../TypeScript",
    "outDir": "../../Content/JavaScript",
    "baseUrl": "../..",
    "paths": {
      "@matrix/puerts-runtime": ["Plugins/EasyEditorPlugin/Typing/@matrix/puerts-runtime/index"]
    },
    "typeRoots": ["./node_modules/@types", "../../Typing", "../../Plugins/Puerts/Typing"]
  },
  "include": ["../../TypeScript/**/*.ts"]
}
